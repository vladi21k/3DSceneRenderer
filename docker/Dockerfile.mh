# Human-figure build image: the tools image plus MPFB2 (MakeHuman for Blender, GPLv3 code)
# and the MakeHuman CC0 system assets (body, skins, eyes, hair, clothes). Only the built output
# (CC0) is shipped in assets/; nothing from this image is redistributed.
# The two archives are fetched by tools/mh_fetch.sh into docker/mh/ (git-ignored).
FROM tramline-tools:latest
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
COPY mh/mpfb.zip mh/system_assets.zip /opt/mh/
ENV BLENDER_USER_RESOURCES=/opt/mh/blender_user
RUN mkdir -p /opt/mh/blender_user /opt/mh/system_assets \
 && unzip -q /opt/mh/system_assets.zip -d /opt/mh/system_assets && rm /opt/mh/system_assets.zip \
 && HOME=/tmp blender -b --factory-startup --python-expr "import bpy; bpy.ops.extensions.package_install_files(filepath='/opt/mh/mpfb.zip', repo='user_default', enable_on_install=True); bpy.ops.wm.save_userpref()" \
 && chmod -R a+rwX /opt/mh
