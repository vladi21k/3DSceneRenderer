#!/usr/bin/env bash
# Run a command inside the tooling container with the project mounted at /work.
#   tools/dk blender -b -P tools/blender/make_lamp.py
#   tools/dk node tools/some_script.mjs
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${TRAM_TOOLS_IMAGE:-tramline-tools:latest}"
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  docker build -t "$IMAGE" "$ROOT/docker"
fi
GPU_ARGS=()
if [[ "${DK_GPU:-0}" == "1" ]]; then GPU_ARGS=(--gpus all -e NVIDIA_DRIVER_CAPABILITIES=all); fi
exec docker run --rm -i "${GPU_ARGS[@]}" -u "$(id -u):$(id -g)" -v "$ROOT:/work" -w /work "$IMAGE" "$@"
