# Tools image for offline asset work and media encoding. The web app itself needs none of it.
#   docker build -t scene-tools:latest -f Dockerfile.tools .      (or let scripts/dk build it on first use)
# Contents: Ubuntu 24.04, Blender LTS (headless: blender -b), Node + gltf-transform,
# Python 3 with numpy / scipy / Pillow, ImageMagick (convert, identify), exiftool, ffmpeg, git.
# Proven combination: Blender 4.5.14 LTS + Node 24.22.0 (Oct 2026). Bump the ARGs to the
# current LTS point releases; keep Blender on an LTS series so scripts do not break mid-project.
FROM ubuntu:24.04

ARG BLENDER_VERSION=4.5.14
ARG BLENDER_SERIES=4.5
ARG NODE_VERSION=24.22.0
ENV DEBIAN_FRONTEND=noninteractive

# Blender's runtime libraries (X11/GL/EGL even when headless), image and video tools
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git make unzip \
      python3 python3-pip python3-numpy python3-scipy python3-pil \
      imagemagick libimage-exiftool-perl ffmpeg \
      libx11-6 libxi6 libxxf86vm1 libxfixes3 libxrender1 libxkbcommon0 libxkbcommon-x11-0 \
      libsm6 libice6 libgl1 libegl1 libglu1-mesa libfontconfig1 libfreetype6 libdbus-1-3 \
      libwayland-client0 libwayland-cursor0 libwayland-egl1 libdecor-0-0 libvulkan1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}-linux-x64.tar.xz \
      | tar -xJ -C /opt && ln -s /opt/blender-${BLENDER_VERSION}-linux-x64/blender /usr/local/bin/blender

RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
      | tar -xJ -C /opt && for b in node npm npx; do ln -s /opt/node-v${NODE_VERSION}-linux-x64/bin/$b /usr/local/bin/$b; done

RUN npm install -g @gltf-transform/cli@4 \
    && ln -sf /opt/node-v${NODE_VERSION}-linux-x64/bin/gltf-transform /usr/local/bin/gltf-transform

# dk runs as the host user (no home inside the image): Blender, npm and Python caches go to /tmp
ENV HOME=/tmp
WORKDIR /work
